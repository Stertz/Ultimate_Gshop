<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ultimate_Gshop"
		xmlns:itens="clr-namespace:Ultimate_Gshop.Itens"
        x:Class="Ultimate_Gshop.MainWindow"
        Title="Ultimate_Gshop"
        Width="1024" Height="720"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">


	<Grid>
		<!-- Sua imagem de fundo -->
		<Image Source="avares://Ultimate_Gshop/Resources/bg.png"
               Stretch="Fill"/>

		<Grid>
			<!-- Background -->
			<!--Image Source="avares://Ultimate_Gshop/Resources/category_frame.png"
				   HorizontalAlignment="Center"
				   VerticalAlignment="Top"
				   Width="110"
				   Height="70"
				   Margin="0,120,675,0"
				   Opacity="0.7"
				   Stretch="Fill"/-->

			<!-- Category Panel -->
			<ItemsControl x:Name="CategoryList"
						  HorizontalAlignment="Center"
						  VerticalAlignment="Top"
						  Margin="0,120,0,0">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Center"
									Spacing="20"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid Width="90" Height="90">
							<!-- Background -->
							<Image Source="avares://Ultimate_Gshop/Resources/category_frame.png"
								   Stretch="Fill"/>

							<!-- Icon -->
							<!--Image Source="{Binding Icon}"
								   Width="50"
								   Height="50"
								   VerticalAlignment="Top"
								   HorizontalAlignment="Center"
								   Margin="0,5,0,0"/-->

							<!-- Text -->
							<TextBlock Text="{Binding Title}"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Bottom"
									   Margin="0,0,0,5"
									   Foreground="White"
									   FontSize="14"
									   TextAlignment="Center"/>
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Grid>


		<!-- Grid Pesquisa e Lista de Itens -->
		<Grid Width="420" Height="470" Margin="70,180,0,0" HorizontalAlignment="Left">
			<!-- Background -->
			<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
				   Stretch="Fill"
				   Opacity="0.85"/>

			<!-- Barra de pesquisa -->
			<Grid HorizontalAlignment="Left"
				  VerticalAlignment="Top"
				  Width="335"
				  Height="25"
				  Margin="22,30,0,0">
				<!-- Imagem de fundo da barra -->
				<Image Source="avares://Ultimate_Gshop/Resources/search_bar.png"
					   Stretch="Fill"/>
				<!-- Campo de texto -->
				<TextBox x:Name="SearchBox"
         Background="Transparent"
         BorderThickness="0"
         Foreground="White"
         FontSize="14"
         VerticalContentAlignment="Center"
         Padding="5,0"
         Focusable="True">
					<TextBox.Styles>
						<Style Selector="TextBox:pointerover /template/ Border">
							<Setter Property="BorderBrush" Value="Transparent"/>
							<Setter Property="Background" Value="Transparent"/>
						</Style>
						<Style Selector="TextBox:focus /template/ Border">
							<Setter Property="BorderBrush" Value="Transparent"/>
							<Setter Property="Background" Value="Transparent"/>
						</Style>
					</TextBox.Styles>
				</TextBox>

			</Grid>

			<!-- Icone de pesquisa -->
			<Image Source="avares://Ultimate_Gshop/Resources/search.png"
				   HorizontalAlignment="Right"
				   VerticalAlignment="Top"
				   Width="25"
				   Height="25"
				   Stretch="Fill"
				   Margin="0,30,30,0"/>
			<!-- ScrollViewer sobre a imagem, relativo ao Grid -->
			<ScrollViewer Width="390"
						  Height="390"
						  Margin="15,60,15,20"
						  VerticalAlignment="Top"
						  VerticalScrollBarVisibility="Visible">
				<ItemsControl x:Name="ItemList">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="itens:Item">
							<Border x:Name="CardBorder"
									CornerRadius="4"
									BorderThickness="0"
									BorderBrush="Transparent"
									Margin="2"
									BoxShadow="0 0 10 0 Transparent">
								<Grid Width="180" Height="80" Margin="5"
									  PointerPressed="OnItemCard_PointerPressed">

									<Image Source="avares://Ultimate_Gshop/Resources/item_slot_frame.png"
									   Stretch="Fill"/>

									<Image Source="{Binding Icon}"
										   Width="25" Height="25"
										   HorizontalAlignment="Left"
										   VerticalAlignment="Top"
										   Margin="12,37,0,0"/>

									<TextBlock Text="{Binding Name}"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Top"
											   Margin="0,7,0,0"
											   FontSize="11"
											   Foreground="White"/>

									<TextBlock Text="{Binding Id, StringFormat=ID: {0}}"
											   HorizontalAlignment="Left"
											   VerticalAlignment="Top"
											   Margin="50,32,0,0"
											   FontSize="10"
											   FontWeight="Bold"
											   Foreground="Gray"/>

									<TextBlock Text="{Binding LimitPeriod}"
											   HorizontalAlignment="Right"
											   VerticalAlignment="Top"
											   Margin="0,32,10,0"
											   FontSize="11"
											   Foreground="Gray"/>

									<!--
									<TextBlock Text="{Binding Price, StringFormat=${0:F2} GOLD}"
											   HorizontalAlignment="Left"
											   VerticalAlignment="Top"
											   Margin="50,45,0,0"
											   FontSize="8"
											   Foreground="#ebb935"/>-->

									<TextBlock Text="{Binding Amount, StringFormat={}{0} Qtd}"
											   HorizontalAlignment="Right"
											   VerticalAlignment="Top"
											   Margin="0,45,10,2"
											   FontSize="8"
											   Foreground="DarkKhaki"/>

									<!-- Botão Copiar -->
									<Button Width="55"
											Height="30"
											Margin="40,0,0,0"
											Background="Transparent"
											BorderBrush="Transparent"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Opacity="0.9"
											Click="CopyButton_Click">
										<Grid>
											<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
											<TextBlock Text="Copiar"
													   Foreground="White"
													   FontSize="7.5"
													   FontWeight="Bold"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
										</Grid>
									</Button>

									<!-- Botão Editar -->
									<Button Width="55"
											Height="30"
											Margin="82.5,0,0,0"
											Background="Transparent"
											BorderBrush="Transparent"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Opacity="0.9"
											Click="EditButton_Click">
										<Grid>
											<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
											<TextBlock Text="Editar"
													   Foreground="White"
													   FontSize="7.5"
													   FontWeight="Bold"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
										</Grid>
									</Button>

									<!-- Botão Excluir -->
									<Button Width="55"
											Height="30"
											Margin="125,0,0,0"
											Background="Transparent"
											BorderBrush="Transparent"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Opacity="0.9"
											Click="DeleteButton_Click">
										<Grid>
											<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
											<TextBlock Text="Excluir"
													   Foreground="White"
													   FontSize="7.5"
													   FontWeight="Bold"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
										</Grid>
									</Button>

								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>

		<!-- Detalhe de Itens -->
		<Grid HorizontalAlignment="Center"
			  Width="340"
			  Height="470"
			  Margin="300,180,0,0"
			  Opacity="0.9">

			<!-- Fundo -->
			<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
				   Stretch="Fill"/>

			<!-- Painel de detalhes à direita -->
			<StackPanel HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Margin="0,15,0,0"
						Width="320"
						Spacing="6">

				<!-- Icone com moldura -->
				<Grid HorizontalAlignment="Center" Margin="0,15,0,15">
					<Image Source="avares://Ultimate_Gshop/Resources/frame.png"
						   Width="100" Height="100"
						   Stretch="Fill"/>
					<Image x:Name="DetailIcon"
						   Width="60" Height="60"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"/>
				</Grid>

				<!-- Nome -->
				<TextBox Text="Name"
                 Watermark="Nome"
                 IsReadOnly="True"
                 Width="280"
                 Background="#344c51"
                 BorderBrush="#5d5737"
                 Foreground="White"
                 CornerRadius="4"
                 Padding="6,3">
					<TextBox.Styles>
						<!-- Quando estiver vazio -->
						<Style Selector="TextBox">
							<Setter Property="Opacity" Value="0.6"/>
						</Style>
						<!-- Quando tem texto -->
						<Style Selector="TextBox:notempty">
							<Setter Property="Opacity" Value="1"/>
							<Setter Property="Foreground" Value="White"/>
						</Style>
					</TextBox.Styles>
				</TextBox>
			</StackPanel>

		</Grid>

		<!-- Botão de fechar -->
		<Button Width="45"
				Height="45"
				Margin="0,75,60,0"
				Background="Transparent"
				BorderBrush="Transparent"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Click="CloseButton_Click">
			<Image Source="avares://Ultimate_Gshop/Resources/btn_close.png"/>
		</Button>

		<!-- Área transparente para arrastar a janela - Ultimate_Gshop -->
		<Border Background="Transparent"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Top"
				Width="250"
				Height="50"
				Margin="0,33,0,0"
				PointerPressed="TopDrag_PointerPressed">

			<TextBlock Text="Ultimate_Gshop"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           FontSize="24"
		   FontWeight="Bold"
           Foreground="#ebb935"/>
		</Border>
	</Grid>

</Window>
