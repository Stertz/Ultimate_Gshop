<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ultimate_Gshop"
		xmlns:itens="clr-namespace:Ultimate_Gshop.Itens"
        x:Class="Ultimate_Gshop.MainWindow"
        Title="Ultimate_Gshop"
        Width="1024" Height="760"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">


	<Grid>
		<!-- Sua imagem de fundo -->
		<Image Source="avares://Ultimate_Gshop/Resources/bg.png"
               Stretch="Fill"/>

			<!-- Nav Button -->
			<Button Width="60"
					Height="60"
					Background="Transparent"
					BorderBrush="Transparent"
					HorizontalAlignment="Left"
					Opacity="0.95"
					VerticalAlignment="Top"
					Margin="75,85,0,0"
					Click="NavButton_Click">
				<Image Source="avares://Ultimate_Gshop/Resources/menu.png"
					   Stretch="Uniform"/>
			</Button>

		<!-- Category Panel -->
		<Grid>
			<ItemsControl x:Name="CategoryList"
						  HorizontalAlignment="Center"
						  VerticalAlignment="Top"
						  Margin="0,155,0,0">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Center"
									Spacing="20"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border CornerRadius="4"
								BorderThickness="0"
								BorderBrush="Transparent"
								Margin="2"
								BoxShadow="0 0 10 0 Transparent">
							<Grid Width="100" Height="60" PointerPressed="OnCategoryClick">
								<Image Source="avares://Ultimate_Gshop/Resources/category_frame.png"
									   Opacity="0.60"
									   Stretch="Fill"/>
								<TextBlock Text="{Binding Title}"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Bottom"
										   Margin="0,0,0,7"
										   Foreground="White"
										   FontWeight="Bold"
										   FontSize="14"
										   TextAlignment="Center"/>
							</Grid>
						</Border>
					</DataTemplate>

				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- SubCategory Panel -->
			<ItemsControl x:Name="SubCategoryList"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,215,0,0">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal"
								   HorizontalAlignment="Center"
								   ItemWidth="80"
								   ItemHeight="40"
								   Margin="5"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border CornerRadius="4"
								BorderThickness="0"
								BorderBrush="Transparent"
								Margin="2"
								BoxShadow="0 0 10 0 Transparent">
							<Grid Width="70" Height="30" PointerPressed="OnSubCategoryClick">
								<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
									   Opacity="0.85"
									   Stretch="Fill"/>
								<TextBlock Text="{Binding}"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Bottom"
										   Margin="0,0,0,7"
										   Foreground="White"
										   FontWeight="DemiBold"
										   FontSize="12"
										   TextAlignment="Center"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Grid>


		<!-- Grid Pesquisa e Lista de Itens -->
		<Grid Width="540" Height="470" Margin="70,230,0,0" HorizontalAlignment="Left">
			<!-- Background -->
			<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
				   Stretch="Fill"
				   Opacity="0.85"/>

			<!-- Barra de pesquisa -->
			<Grid HorizontalAlignment="Left"
				  VerticalAlignment="Top"
				  Width="420"
				  Height="25"
				  Margin="40,35,0,0">
				<!-- Imagem de fundo da barra -->
				<Image Source="avares://Ultimate_Gshop/Resources/search_bar.png"
					   Stretch="Fill"/>
				<!-- Campo de texto -->
				<TextBox x:Name="SearchBox"
						 KeyDown="SearchBox_KeyDown"
						 Background="Transparent"
						 BorderThickness="0"
						 Foreground="White"
						 FontSize="14"
						 VerticalContentAlignment="Center"
						 Padding="5,0"
						 Focusable="True">
					<TextBox.Styles>
						<Style Selector="TextBox:pointerover /template/ Border">
							<Setter Property="BorderBrush" Value="Transparent"/>
							<Setter Property="Background" Value="Transparent"/>
						</Style>
						<Style Selector="TextBox:focus /template/ Border">
							<Setter Property="BorderBrush" Value="Transparent"/>
							<Setter Property="Background" Value="Transparent"/>
						</Style>
					</TextBox.Styles>
				</TextBox>

			</Grid>

			<!-- Icone de pesquisa -->
			<Button Width="40"
					Height="40"
					HorizontalAlignment="Right"
					VerticalAlignment="Top"
					Margin="0,30,40,0"
					Background="Transparent"
					BorderBrush="Transparent"					
					Click="SearchIcon_Click">
				<Image Source="avares://Ultimate_Gshop/Resources/search.png"
					   Stretch="Fill"
					   Width="35"
					   Height="35"/>
			</Button>

			<!-- ScrollViewer sobre a imagem, relativo ao Grid -->
			<ScrollViewer Width="460"
						  Height="390"
						  Margin="0,65,0,0"
						  VerticalAlignment="Top"
						  VerticalScrollBarVisibility="Visible">
				<ItemsRepeater x:Name="ItemList">
					<ItemsRepeater.Layout>
						<UniformGridLayout Orientation="Horizontal"
										   MinRowSpacing="5"
										   MinColumnSpacing="5"/>
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate>
							<Border x:Name="CardBorder"
									CornerRadius="4"
									BorderThickness="0"
									BorderBrush="Transparent"
									Margin="2"
									BoxShadow="0 0 10 0 Transparent">
								<Grid Width="218" Height="92" Margin="0.8"
									  PointerPressed="OnItemCard_PointerPressed">

									<Image Source="avares://Ultimate_Gshop/Resources/item_slot_frame.png"
										   Stretch="Fill"/>

									<Image Source="{Binding IconBitmap}"
										   Width="31" Height="31"
										   HorizontalAlignment="Left"
										   VerticalAlignment="Top"
										   Margin="13,42,0,0"/>

									<TextBlock Text="{Binding Name}"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Top"
											   Margin="0,7,0,0"
											   FontSize="11"
											   FontWeight="Bold"
											   Foreground="White"/>

									<TextBlock Text="{Binding Id, StringFormat=ID: {0}}"
											   HorizontalAlignment="Left"
											   VerticalAlignment="Top"
											   Margin="60,34,0,0"
											   FontSize="11"
											   Foreground="White"/>

									<TextBlock Text="{Binding LimitPeriod}"
											   HorizontalAlignment="Right"
											   VerticalAlignment="Top"
											   Margin="0,34,10,0"
											   FontSize="11"
											   Foreground="White"/>

									<TextBlock Text="{Binding Amount, StringFormat={}{0} Qtd}"
											   HorizontalAlignment="Right"
											   VerticalAlignment="Top"
											   Margin="0,48,10,2"
											   FontSize="11"
											   Foreground="DarkKhaki"/>

									<!-- Botão Copiar -->
									<Button Width="67.5"
											Height="35"
											Margin="45,0,0,0"
											Background="Transparent"
											BorderBrush="Transparent"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Opacity="0.9"
											Click="CopyButton_Click">
										<Grid>
											<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
											<TextBlock Text="Copiar"
													   Foreground="White"
													   FontSize="8"
													   FontWeight="Bold"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
										</Grid>
									</Button>

									<!-- Botão Editar -->
									<Button Width="67.5"
											Height="35"
											Margin="97.5,0,0,0"
											Background="Transparent"
											BorderBrush="Transparent"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Opacity="0.9"
											Click="CopyButton_Click">
										<Grid>
											<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
											<TextBlock Text="Editar"
													   Foreground="White"
													   FontSize="8"
													   FontWeight="Bold"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
										</Grid>
									</Button>

									<!-- Botão Excluir -->
									<Button Width="67.5"
											Height="35"
											Margin="150,0,0,0"
											Background="Transparent"
											BorderBrush="Transparent"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Opacity="0.9"
											Click="CopyButton_Click">
										<Grid>
											<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
											<TextBlock Text="Excluir"
													   Foreground="White"
													   FontSize="8"
													   FontWeight="Bold"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
										</Grid>
									</Button>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>
			</ScrollViewer>
		</Grid>

		<!-- Detalhe de Itens -->
		<Grid HorizontalAlignment="Right"
			  Width="340"
			  Height="470"
			  Margin="0,230,70,0"
			  Opacity="0.9">

			<!-- Fundo -->
			<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
				   Stretch="Fill"/>


			<!-- Painel de detalhes à direita -->
			<StackPanel HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Margin="0,25,0,0"
						Width="320"
						Spacing="6">
				<Canvas>
					<Button Width="40"
							Height="40"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Canvas.Right="10"
							Canvas.Top="10"
							Click="ItemEditorButton_Click">
						<Image Source="avares://Ultimate_Gshop/Resources/settings.png"
							   Stretch="Uniform"/>
					</Button>
				</Canvas>

				<!-- Icone com moldura -->
				<Grid HorizontalAlignment="Center" Margin="0,15,0,15">
					<Image Source="avares://Ultimate_Gshop/Resources/frame.png"
						   Width="100" Height="100"
						   Stretch="Fill"/>
					<Image x:Name="DetailIcon"
						   Width="60" Height="60"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"/>
				</Grid>

				<!-- Nome -->
				<TextBox x:Name="DetailName"
						 Watermark="Nome"
						 IsReadOnly="True"
						 Width="280"
						 Background="#344c51"
						 BorderBrush="#5d5737"
						 Foreground="White"
						 CornerRadius="4"
						 Padding="6,3">
					<TextBox.Styles>
						<!-- Quando estiver vazio -->
						<Style Selector="TextBox">
							<Setter Property="Opacity" Value="0.6"/>
						</Style>
						<!-- Quando tem texto -->
						<Style Selector="TextBox:notempty">
							<Setter Property="Opacity" Value="1"/>
							<Setter Property="Foreground" Value="White"/>
						</Style>
					</TextBox.Styles>
				</TextBox>

				<!-- Container para botões na parte inferior -->
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Center"
							VerticalAlignment="Bottom"
							Margin="0,0,0,10"
							Spacing="1">

					<!-- Botão Novo -->
					<Button Width="100"
							Height="60"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Novo"
									   Foreground="White"
									   FontSize="12"
									   FontWeight="Bold"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<!-- Botão Editar -->
					<Button Width="100"
							Height="60"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Editar"
									   Foreground="White"
									   FontSize="12"
									   FontWeight="Bold"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<!-- Botão Excluir -->
					<Button Width="100"
							Height="60"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Excluir"
									   Foreground="White"
									   FontSize="12"
									   FontWeight="Bold"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
						</Grid>
					</Button>

				</StackPanel>
			</StackPanel>

		</Grid>

		<!-- Botão de fechar -->
		<Button Width="55"
				Height="55"
				Margin="0,90,80,0"
				Background="Transparent"
				BorderBrush="Transparent"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Opacity="0.9"
				Click="CloseButton_Click">
			<Image Source="avares://Ultimate_Gshop/Resources/btn_close.png"/>
		</Button>

		<!-- Área transparente para arrastar a janela - Ultimate_Gshop -->
		<Border Background="Transparent"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Top"
				Width="250"
				Height="50"
				Margin="0,33,0,0"
				PointerPressed="TopDrag_PointerPressed">

			<TextBlock Text="Ultimate_Gshop"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           FontSize="24"
		   FontWeight="Bold"
           Foreground="#ebb935"/>
		</Border>
	</Grid>

</Window>
