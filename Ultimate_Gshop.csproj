<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>False</UseWPF>
	<LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="Resources\surfaces\**" />
    <Compile Remove="Resources\surfaces\**" />
    <EmbeddedResource Remove="Resources\surfaces\**" />
    <None Remove="Resources\surfaces\**" />
    <Page Remove="Resources\surfaces\**" />
  </ItemGroup>

	<ItemGroup>
		<None Include="Resources\surfaces\**\*.png" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

  <ItemGroup>
    <None Remove="Resources\bg.png" />
    <None Remove="Resources\btn.png" />
    <None Remove="Resources\btn_close.png" />
    <None Remove="Resources\category_frame.png" />
    <None Remove="Resources\cursor.png" />
    <None Remove="Resources\frame.png" />
    <None Remove="Resources\items_bg.png" />
    <None Remove="Resources\item_slot_frame.png" />
    <None Remove="Resources\menu.png" />
    <None Remove="Resources\paper.png" />
    <None Remove="Resources\question_mark.png" />
    <None Remove="Resources\search.png" />
    <None Remove="Resources\search_bar.png" />
    <None Remove="Resources\settings.png" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\bg.png" />
    <AvaloniaResource Include="Resources\btn.png" />
    <AvaloniaResource Include="Resources\btn_close.png" />
    <AvaloniaResource Include="Resources\category_frame.png" />
    <AvaloniaResource Include="Resources\cursor.png" />
    <AvaloniaResource Include="Resources\frame.png" />
    <AvaloniaResource Include="Resources\items_bg.png" />
    <AvaloniaResource Include="Resources\item_slot_frame.png" />
    <AvaloniaResource Include="Resources\menu.png" />
    <AvaloniaResource Include="Resources\paper.png" />
    <AvaloniaResource Include="Resources\question_mark.png" />
    <AvaloniaResource Include="Resources\search.png" />
    <AvaloniaResource Include="Resources\search_bar.png" />
    <AvaloniaResource Include="Resources\settings.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.2" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.2" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
  </ItemGroup>

</Project>