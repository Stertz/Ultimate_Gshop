<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ultimate_Gshop.Views.CustomMessageBox"
        xmlns:controls="clr-namespace:Ultimate_Gshop.Views.UserControls"
        Width="420"
        SizeToContent="Height"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://Ultimate_Gshop/Resources/icon_gshop.ico">
	<Grid>
		<Grid.Background>
			<ImageBrush Source="avares://Ultimate_Gshop/Resources/items_bg.png" Stretch="Fill"/>
		</Grid.Background>

		<StackPanel VerticalAlignment="Center"
					HorizontalAlignment="Center"
					Margin="0,25"
					Spacing="12">

			<!-- Ícone -->
			<Image x:Name="IconImage"
				   Width="70" Height="70"
				   IsVisible="False"
				   HorizontalAlignment="Center"/>

			<!-- Título -->
			<TextBlock x:Name="TitleBlock"
					   Text="Aviso"
					   Foreground="#ebb935"
					   FontSize="18"
					   FontWeight="Bold"
					   HorizontalAlignment="Center"/>

			<!-- Mensagem -->
			<TextBlock x:Name="MessageBlock"
					   Text="Mensagem genérica"
					   Foreground="White"
					   FontSize="14"
					   TextWrapping="Wrap"
					   TextAlignment="Center"
					   Width="300"/>

			<!-- Input opcional (modo Input) -->
			<StackPanel x:Name="InputPanel"
						IsVisible="False"
						Spacing="6"
						HorizontalAlignment="Center">
				<controls:FloatingLabelTextBox x:Name="InputBox"
											   Label="Digite aqui"
											   Width="300"
											   FontSize="14"
											   Foreground="White"/>
			</StackPanel>

			<!-- Combo 1 (modo Combo) -->
			<StackPanel x:Name="ComboPanel1"
						IsVisible="False"
						Spacing="6"
						HorizontalAlignment="Center"
						Width="300">
				<TextBlock x:Name="Combo1Label"
						   Foreground="#ebb935"
						   FontSize="13"
						   FontWeight="SemiBold"/>
				<ComboBox x:Name="ComboBox1"
						  Width="300"
						  MaxDropDownHeight="260"/>
			</StackPanel>

			<!-- Combo 2 (modo Combo, opcional / dependente) -->
			<StackPanel x:Name="ComboPanel2"
						IsVisible="False"
						Spacing="6"
						HorizontalAlignment="Center"
						Width="300">
				<TextBlock x:Name="Combo2Label"
						   Foreground="#ebb935"
						   FontSize="13"
						   FontWeight="SemiBold"/>
				<ComboBox x:Name="ComboBox2"
						  Width="300"
						  MaxDropDownHeight="260"/>
			</StackPanel>

			<!-- Botões -->
			<StackPanel x:Name="ButtonPanel"
						Orientation="Horizontal"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Spacing="15"/>
		</StackPanel>
	</Grid>
</Window>
