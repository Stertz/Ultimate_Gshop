<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Class="Ultimate_Gshop.Views.UserControls.FloatingLabelTextBox">

	<Border x:Name="Border"
			Background="#344c51"
			BorderBrush="#5d5737"
			BorderThickness="1"
			CornerRadius="4"
			Padding="6,3">

		<Grid>
			<!-- Label flutuante -->
			<TextBlock x:Name="LabelBlock"
					   Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
					   Foreground="Gray"
					   FontSize="12"
					   Margin="2,0,0,0"
					   ZIndex="1"
					   IsHitTestVisible="False"
					   VerticalAlignment="Top"
					   RenderTransformOrigin="0,0">
				<TextBlock.RenderTransform>
					<TranslateTransform Y="14"/>
				</TextBlock.RenderTransform>
			</TextBlock>

			<!-- Campo de texto -->
			<TextBox x:Name="TextField"
					 Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
					 Background="Transparent"
					 BorderBrush="Transparent"
					 Foreground="White"
					 BorderThickness="0"
					 CornerRadius="4"
					 Padding="0,10,0,0"
					 VerticalAlignment="Center"
					 TextInputOptions.ContentType="{Binding ContentType, RelativeSource={RelativeSource AncestorType=UserControl}}">
				<TextBox.Styles>
					<!-- Texto -->
					<Style Selector="TextBox">
						<Setter Property="Foreground" Value="White"/>
					</Style>

					<!-- Hover -->
					<Style Selector="TextBox:pointerover /template/ Border">
						<Setter Property="Background" Value="#3A5055"/>
						<Setter Property="BorderBrush" Value="#5d5737"/>
					</Style>

					<!-- Foco -->
					<Style Selector="TextBox:focus /template/ Border">
						<Setter Property="Background" Value="#415b60"/>
						<Setter Property="BorderBrush" Value="#a59a69"/>
					</Style>
				</TextBox.Styles>
			</TextBox>
		</Grid>
	</Border>
</UserControl>
