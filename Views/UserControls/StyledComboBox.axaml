<UserControl
    x:Class="Ultimate_Gshop.Views.UserControls.StyledComboBox"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Ultimate_Gshop.Views.UserControls">

	<ComboBox x:Name="Combo"
              Width="140"
              Background="#344c51"
              BorderBrush="#5d5737"
              Foreground="White"
              Padding="6,3"
              FontSize="12"
              HorizontalAlignment="Right"
              SelectedIndex="{Binding SelectedIndex, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
              ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
              SelectedItem="{Binding SelectedItem, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}">

		<ComboBox.Styles>
			<Style Selector="ComboBox">
				<Setter Property="Foreground" Value="White"/>
				<Setter Property="FontSize" Value="12"/>
			</Style>
			<Style Selector="ComboBox:pointerover /template/ Border">
				<Setter Property="Background" Value="#3A5055"/>
				<Setter Property="BorderBrush" Value="#5d5737"/>
			</Style>
			<Style Selector="ComboBox:focus /template/ Border">
				<Setter Property="Background" Value="#415b60"/>
				<Setter Property="BorderBrush" Value="#a59a69"/>
			</Style>
			<Style Selector="ComboBox /template/ ScrollViewer">
				<Setter Property="Background" Value="#2f4044"/>
			</Style>
			<Style Selector="ComboBoxItem">
				<Setter Property="FontSize" Value="12"/>
				<Setter Property="Height" Value="24"/>
				<Setter Property="Padding" Value="8,2"/>
				<Setter Property="Background" Value="#2f4044"/>
				<Setter Property="Foreground" Value="White"/>
			</Style>
			<Style Selector="ComboBoxItem:pointerover">
				<Setter Property="Background" Value="#576d72"/>
			</Style>
			<Style Selector="ComboBoxItem:selected">
				<Setter Property="Background" Value="#415b60"/>
			</Style>
		</ComboBox.Styles>
	</ComboBox>
</UserControl>
