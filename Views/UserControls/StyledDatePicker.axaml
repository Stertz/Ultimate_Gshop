<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Class="Ultimate_Gshop.Views.UserControls.StyledDatePicker">
	<StackPanel Spacing="2">
		<TextBlock x:Name="Label"
				   Text="Descrição"
				   FontSize="11"
				   Foreground="White"
				   Margin="2,0,0,0"
				   IsVisible="False"/>

		<Border Background="#344c51"
				BorderBrush="#5d5737"
				BorderThickness="1"
				CornerRadius="4"
				Padding="6,3">

			<Grid>
				<!-- Campo de exibição da data formatada -->
				<TextBlock x:Name="FormattedDateText"
						   Foreground="White"
						   FontSize="12"
						   VerticalAlignment="Center"
						   Margin="2,0,20,0"/>

				<!-- DatePicker invisível, só para abrir o seletor -->
				<DatePicker x:Name="Picker"
							Opacity="0"
							Background="Transparent"
							BorderBrush="Transparent"
							FontSize="12"
							HorizontalAlignment="Stretch"/>
			</Grid>
		</Border>
	</StackPanel>
</UserControl>
