<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ultimate_Gshop.Views.UserControls.ExplanationEditorControl"
             Width="280" Height="110">
	<Border Background="#344c51" BorderBrush="#5d5737" BorderThickness="1" CornerRadius="4">
		<Grid>
			<!-- EDITOR -->
			<TextBox x:Name="EditorTextBox"
					 Background="Transparent"
					 BorderBrush="Transparent"
					 Foreground="White"
					 CornerRadius="4"
					 Padding="6,3"
					 FontSize="12"
					 TextWrapping="Wrap"
					 AcceptsReturn="True"
					 Watermark="Descrição"
					 IsVisible="False"
					 IsEnabled="False">
				<TextBox.Styles>
					<Style Selector="TextBox">
						<Setter Property="Foreground" Value="White"/>
					</Style>
					<Style Selector="TextBox:pointerover /template/ Border">
						<Setter Property="Background" Value="#3A5055"/>
						<Setter Property="BorderBrush" Value="#5d5737"/>
					</Style>
					<Style Selector="TextBox:focus /template/ Border">
						<Setter Property="Background" Value="#415b60"/>
						<Setter Property="BorderBrush" Value="#a59a69"/>
					</Style>
				</TextBox.Styles>
			</TextBox>

			<!-- PREVIEW -->
			<ScrollViewer x:Name="PreviewHost" Background="Transparent" FontSize="12">
				<TextBlock x:Name="PreviewTextBlock"
						   TextWrapping="Wrap"
						   Padding="6,3"
						   Background="Transparent"
						   Foreground="White"/>
			</ScrollViewer>

			<!-- Toggle -->
			<Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,37,0">
				<Button Width="30" Height="30"
						Padding="0"
						Opacity="0.9"
						Background="Transparent"
						BorderBrush="Transparent"
						Click="OnTogglePreviewClick">
					<Image x:Name="ToggleIcon"
						   Source="avares://Ultimate_Gshop/Resources/preview.png"
						   Stretch="Uniform"/>
				</Button>
			</Canvas>

			<!-- Palette -->
			<Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,32,35,0">
				<Button x:Name="PaletteButton"
						Width="27" Height="27"
						Padding="0"
						IsVisible="False"
						Background="Transparent"
						BorderBrush="Transparent"
						Opacity="0.25"
						IsEnabled="False"
						Click="OnPaletteClick">
					<Image Source="avares://Ultimate_Gshop/Resources/color_palette.png"
						   Stretch="Uniform"/>
				</Button>
			</Canvas>
		</Grid>
	</Border>
</UserControl>
