<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ultimate_Gshop"
		xmlns:itens="clr-namespace:Ultimate_Gshop.Itens"
		xmlns:controls="clr-namespace:Ultimate_Gshop.Views.UserControls"
        x:Class="Ultimate_Gshop.MainWindow"
        Title="Ultimate_Gshop"
        Width="1024" Height="760"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
		CanResize="False"
        Background="Transparent"
		Icon="avares://Ultimate_Gshop/Resources/icon_gshop.ico">


	<Grid>
		<!-- Sua imagem de fundo -->
		<Image Source="avares://Ultimate_Gshop/Resources/bg.png"
               Stretch="Fill"/>

		<!-- Nav Button -->
		<Button Width="45" Height="45"
				Margin="80,90,0,0" Padding="0"
				Background="Transparent"
				BorderBrush="Transparent"
				HorizontalAlignment="Left"
				Opacity="0.95"
				VerticalAlignment="Top"
				Click="NavButton_Click">
			<Image Source="avares://Ultimate_Gshop/Resources/menu.png"
				   Stretch="Uniform"/>
		</Button>

		<!-- Undo Arrow -->
		<Button x:Name="UndoButton"
				Width="42" Height="42"
				Margin="130,92,0,0" Padding="0"
				Background="Transparent"
				BorderBrush="Transparent"
				HorizontalAlignment="Left"
				Opacity="0.25"
				VerticalAlignment="Top"
				Click="Undo_Click">
			<Image Source="avares://Ultimate_Gshop/Resources/undo_arrow.png"
				   Stretch="Uniform"/>
		</Button>

		<!-- Redo Arrow -->
		<Button x:Name="RedoButton"
				Width="42" Height="42"
				Margin="170,92,0,0" Padding="0"
				Background="Transparent"
				BorderBrush="Transparent"
				HorizontalAlignment="Left"
				Opacity="0.25"
				VerticalAlignment="Top"
				Click="Redo_Click">
			<Image Source="avares://Ultimate_Gshop/Resources/redo_arrow.png"
				   Stretch="Uniform"/>
		</Button>

		<!-- Category Panel -->
		<Grid>
			<ItemsControl x:Name="CategoryList"
						  HorizontalAlignment="Center"
						  VerticalAlignment="Top"
						  Margin="0,155,0,0">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Center"
									Spacing="10"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border CornerRadius="4"
								BorderThickness="0"
								BorderBrush="Transparent"
								Margin="2"
								BoxShadow="0 0 10 0 Transparent">
							<Grid Width="100" Height="60" PointerPressed="OnCategoryClick">
								<Image Source="avares://Ultimate_Gshop/Resources/category_frame.png"
									   Opacity="0.60"
									   Stretch="Fill"/>

								<!-- Conteúdo do botão -->
								<StackPanel VerticalAlignment="Center"
											HorizontalAlignment="Center"
											Spacing="2">
									<!-- Ícone -->
									<Image Source="avares://Ultimate_Gshop/Resources/question_mark.png"
										   Width="24"
										   Height="24"
										   Stretch="Uniform"/>

									<!-- Texto -->
									<TextBlock Text="{Binding Title}"
											   HorizontalAlignment="Center"
											   Foreground="White"
											   FontWeight="Bold"
											   FontSize="14"
											   TextAlignment="Center"/>
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>

				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- SubCategory Panel -->
			<ItemsControl x:Name="SubCategoryList"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,215,0,0">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal"
								   HorizontalAlignment="Center"
								   ItemWidth="80"
								   ItemHeight="40"
								   Margin="5"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border CornerRadius="4"
								BorderThickness="0"
								BorderBrush="Transparent"
								Margin="2"
								BoxShadow="0 0 10 0 Transparent">
							<Grid Width="70" Height="30" PointerPressed="OnSubCategoryClick">
								<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
									   Opacity="0.85"
									   Stretch="Fill"/>
								<TextBlock Text="{Binding}"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Bottom"
										   Margin="0,0,0,7"
										   Foreground="White"
										   FontWeight="DemiBold"
										   FontSize="12"
										   TextAlignment="Center"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Grid>

		<!-- Grid Pesquisa e Lista de Itens -->
		<Grid Width="540" Height="470" Margin="70,230,0,0" HorizontalAlignment="Left">
			<!-- Background -->
			<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
				   Stretch="Fill"
				   Opacity="0.85"/>

			<!-- Barra de pesquisa -->
			<Grid HorizontalAlignment="Left"
				  VerticalAlignment="Top"
				  Width="420"
				  Height="25"
				  Margin="40,35,0,0">
				<!-- Imagem de fundo da barra -->
				<Image Source="avares://Ultimate_Gshop/Resources/search_bar.png"
					   Stretch="Fill"/>
				<!-- Campo de texto -->
				<TextBox x:Name="SearchBox"
						 KeyDown="SearchBox_KeyDown"
						 Background="Transparent"
						 BorderThickness="0"
						 Foreground="White"
						 FontSize="14"
						 VerticalContentAlignment="Center"
						 Padding="10,0">
					<TextBox.Styles>
						<Style Selector="TextBox:pointerover /template/ Border">
							<Setter Property="BorderBrush" Value="Transparent"/>
							<Setter Property="Background" Value="Transparent"/>
						</Style>
						<Style Selector="TextBox:focus /template/ Border">
							<Setter Property="BorderBrush" Value="Transparent"/>
							<Setter Property="Background" Value="Transparent"/>
						</Style>
					</TextBox.Styles>
				</TextBox>
			</Grid>

			<!-- Icone de pesquisa -->
			<Button Width="40"
					Height="40"
					HorizontalAlignment="Right"
					VerticalAlignment="Top"
					Margin="0,30,40,0" Padding="0"
					Background="Transparent"
					BorderBrush="Transparent"
					Click="SearchIcon_Click">
				<Image Source="avares://Ultimate_Gshop/Resources/search.png"
					   Stretch="Fill"
					   Width="35"
					   Height="35"/>
			</Button>

			<!-- ScrollViewer sobre a imagem, relativo ao Grid -->
			<ScrollViewer Width="460"
						  Height="380"
						  Margin="0,70,0,0"
						  VerticalAlignment="Top"
						  VerticalScrollBarVisibility="Visible">
				<ItemsRepeater x:Name="ItemList">
					<ItemsRepeater.Layout>
						<UniformGridLayout Orientation="Horizontal"
										   MinRowSpacing="5"
										   MinColumnSpacing="5"/>
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate>
							<Border x:Name="CardBorder"
									CornerRadius="4"
									BorderThickness="0"
									BorderBrush="Transparent"
									Margin="2"
									BoxShadow="0 0 10 0 Transparent">
								<Grid Width="218" Height="92" Margin="0.8"
									  PointerPressed="OnItemCard_PointerPressed" Tag="{Binding Tag}">

									<Image Source="avares://Ultimate_Gshop/Resources/item_slot_frame.png"
										   Stretch="Fill"/>

									<Image Source="{Binding IconBitmap}"
										   Width="31" Height="31"
										   HorizontalAlignment="Left"
										   VerticalAlignment="Top"
										   Margin="13,42,0,0"/>

									<TextBlock Text="{Binding Name}"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Top"
											   Margin="0,7,0,0"
											   FontSize="11"
											   FontWeight="Bold"
											   Foreground="White"/>

									<TextBlock Text="{Binding ID, StringFormat=ID: {0}}"
											   HorizontalAlignment="Left"
											   VerticalAlignment="Top"
											   Margin="60,34,0,0"
											   FontSize="11"
											   FontWeight="DemiBold"
											   Foreground="White"/>

									<TextBlock Text="{Binding Price, StringFormat={}{0} GOLD}"
											   HorizontalAlignment="Left"
											   VerticalAlignment="Top"
											   Margin="60,48.5,0,0"
											   FontSize="10.5"
											   FontWeight="DemiBold"
											   Foreground="#ebb935"/>

									<TextBlock Text="{Binding LimitPeriod}"
											   HorizontalAlignment="Right"
											   VerticalAlignment="Top"
											   Margin="0,34,10,0"
											   FontSize="11"
											   FontWeight="DemiBold"
											   Foreground="White"/>

									<TextBlock Text="{Binding Amount, StringFormat={}{0} Qtd}"
											   HorizontalAlignment="Right"
											   VerticalAlignment="Top"
											   Margin="0,48.5,10,0"
											   FontSize="10.5"
											   FontWeight="DemiBold"
											   Foreground="DarkKhaki"/>

									<!-- Botão Copiar -->
									<Button Width="52" Height="29"
											Margin="55,0,0,3" Padding="0"
											Background="Transparent"
											BorderBrush="Transparent"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Opacity="0.9"
											Click="ItemCopyButton_Click"
											Tag="{Binding Tag}">
										<Grid>
											<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
											<TextBlock Text="Copiar"
													   Foreground="White"
													   FontSize="9"
													   FontWeight="DemiBold"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
										</Grid>
									</Button>

									<!-- Botão Editar -->
									<Button Width="52" Height="29"
											Margin="107,0,0,3" Padding="0"
											Background="Transparent"
											BorderBrush="Transparent"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Opacity="0.9"
											Click="ItemEditButton_Click"
											Tag="{Binding Tag}">
										<Grid>
											<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
											<TextBlock Text="Editar"
													   Foreground="White"
													   FontSize="9"
													   FontWeight="DemiBold"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
										</Grid>
									</Button>

									<!-- Botão Excluir -->
									<Button Width="52" Height="29"
											Margin="160,0,0,3" Padding="0"
											Background="Transparent"
											BorderBrush="Transparent"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Opacity="0.9"
											Click="ItemDeleteButton_Click"
											Tag="{Binding Tag}">
										<Grid>
											<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
											<TextBlock Text="Excluir"
													   Foreground="White"
													   FontSize="9"
													   FontWeight="DemiBold"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
										</Grid>
									</Button>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>
			</ScrollViewer>
		</Grid>

		<!-- Detalhe de Itens -->
		<Grid HorizontalAlignment="Right"
			  Width="340"
			  Height="470"
			  Margin="0,230,70,0"
			  Opacity="0.9">

			<!-- Fundo -->
			<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
				   Stretch="Fill"/>

			<!-- Container geral com conteúdo e botões -->
			<Grid>
				<Grid.RowDefinitions>
					<!-- Conteúdo com scroll -->
					<RowDefinition Height="*" />
					<!-- Área fixa para os botões -->
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<!-- Scroll apenas no conteúdo -->
				<ScrollViewer Grid.Row="0"
							  Width="320"
							  Margin="0,20,0,0"
							  HorizontalScrollBarVisibility="Disabled"
							  VerticalScrollBarVisibility="Auto">
					<StackPanel x:Name="DetailPanel"
								Margin="0,20,0,0"
								Spacing="6">

						<!-- Ícone com moldura -->
						<Grid HorizontalAlignment="Center" Margin="0,0,0,15">
							<Image Source="avares://Ultimate_Gshop/Resources/frame.png"
								   Width="100" Height="100"
								   Stretch="Fill"/>
							<Image x:Name="DetailIcon"
								   Width="60" Height="60"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"/>
						</Grid>

						<!-- ID + Amount -->
						<Grid Width="280" ColumnDefinitions="*,*" ColumnSpacing="4">
							<!-- ID (somente números) -->
							<controls:FloatingLabelTextBox
								x:Name="DetailID"
								Label="ID"
								IsEnabled="False"
								ContentType="Number"/>

							<!-- Amount -->
							<controls:FloatingLabelTextBox
								x:Name="DetailAmount"
								Grid.Column="1"
								Label="Amount"
								IsEnabled="False"
								ContentType="Number"/>
						</Grid>

						<!-- Nome -->
						<controls:FloatingLabelTextBox
								x:Name="DetailName"
								Width="280"
								Label="Name"
								IsEnabled="False"/>

						<!-- Time Limit + Avail Frequency -->
						<Grid Width="280" ColumnDefinitions="*,*" ColumnSpacing="4">
							<!-- Time Limit -->
							<controls:FloatingLabelTextBox
								x:Name="DetailLimitPeriod"
								Label="Limit Period"
								IsEnabled="False"
								ContentType="Number"/>

							<!-- Avail Frequency -->
							<controls:FloatingLabelTextBox
								Grid.Column="1"
								x:Name="DetailAvailFrequency"
								Label="Avail Frequency"
								IsEnabled="False"
								ContentType="Number"/>
						</Grid>

						<!-- Descrição com alternância -->
						<Border Background="#344c51"
								BorderBrush="#5d5737"
								BorderThickness="1"
								CornerRadius="4"
								Width="280"
								Height="110">
							<Grid>
								<!-- Editor (TextBox com texto bruto, usado para editar) -->
								<TextBox x:Name="DetailExplanationEditor"
										 Background="Transparent"
										 BorderBrush="Transparent"
										 Foreground="White"
										 CornerRadius="4"
										 Padding="6,3"
										 FontSize="12"
										 TextWrapping="Wrap"
										 AcceptsReturn="True"
										 Watermark="Descrição"
										 IsVisible="False"
										 IsEnabled="False">
									<TextBox.Styles>
										<Style Selector="TextBox">
											<Setter Property="Foreground" Value="White"/>
										</Style>
										<!-- Hover -->
										<Style Selector="TextBox:pointerover /template/ Border">
											<Setter Property="Background" Value="#3A5055"/>
											<Setter Property="BorderBrush" Value="#5d5737"/>
										</Style>
										<!-- Focus -->
										<Style Selector="TextBox:focus /template/ Border">
											<Setter Property="Background" Value="#415b60"/>
											<Setter Property="BorderBrush" Value="#a59a69"/>
										</Style>
									</TextBox.Styles>
								</TextBox>

								<!-- Visual (TextBlock com cores, usado só para visualizar) -->
								<ScrollViewer x:Name="DetailExplanationPreview"
											  Background="Transparent"
											  FontSize="12">
									<TextBlock x:Name="DetailExplanation"
											   TextWrapping="Wrap"
											   Padding="6,3"
											   Background="Transparent"
											   Foreground="White"/>
								</ScrollViewer>

								<!-- Preview - Unpreview -->
								<Canvas HorizontalAlignment="Right" VerticalAlignment="Top"
										Margin="0,0,37,0">
									<Button Width="30" Height="30"
											Padding="0"
											Background="Transparent"
											BorderBrush="Transparent"
											Click="PreviewToggle_Click">
										<Image x:Name="PreviewButtonIcon"
											   Source="avares://Ultimate_Gshop/Resources/preview.png"
											   Stretch="Uniform"/>
									</Button>
								</Canvas>

								<!-- Color Palette -->
								<Canvas HorizontalAlignment="Right" VerticalAlignment="Top"
										Margin="0,32,35,0">
									<Button x:Name="DetailPaletteButton" 
											Width="27" Height="27"
											Padding="0"
											IsVisible="False"
											Background="Transparent"
											BorderBrush="Transparent"
											Opacity="0.25"
											IsEnabled="False"
											Click="DetailPaletteButton_Click">
										<Image Source="avares://Ultimate_Gshop/Resources/color_palette.png"
											   Stretch="Uniform"/>
									</Button>
								</Canvas>

							</Grid>
						</Border>

						<!-- Grid de Class +  -->
						<Grid ColumnDefinitions="*,auto"
							  ColumnSpacing="4"
							  Width="280">
							<!-- Class -->
							<controls:StyledComboBox
								x:Name="DetailClassComboBox"
								LabelText="Class"
								IsEnabled="False"
								HorizontalAlignment="Stretch"/>

							<!-- Sale -->
							<Button Grid.Column="1"
									x:Name="DetailSaleButton"
									Width="45" Height="45"
									Background="Transparent"
									BorderBrush="Transparent"
									IsDefault="False"
									Margin="0,5,0,0" Padding="0"
									Opacity="0.25"
									IsEnabled="False"
									Click="SaleEditor_Click">
								<Image Source="avares://Ultimate_Gshop/Resources/btn_sale.png"/>
							</Button>
						</Grid>

						<!-- Categorie + SubCategorie -->
						<Grid Width="280" ColumnDefinitions="*,*" ColumnSpacing="4">
							<!-- ComboBox para selecionar categoria -->
							<controls:StyledComboBox
								x:Name="DetailCategoryComboBox"
								LabelText="Categorie"
								IsEnabled="False"/>

							<!-- ComboBox para selecionar categoria -->
							<controls:StyledComboBox
								Grid.Column="1"
								x:Name="DetailSubCategoryComboBox"
								LabelText="SubCategorie"
								IsEnabled="False"/>
						</Grid>

						<!-- Gift -->
						<Border Background="#344c51"
								BorderBrush="#5d5737"
								BorderThickness="1"
								CornerRadius="4"
								Padding="10"
								Width="280">
							<StackPanel>
								<Grid ColumnDefinitions="auto,*" ColumnSpacing="4">
									<!-- Ícone com moldura -->
									<Grid HorizontalAlignment="Left" Margin="0,0,0,10">
										<Image Source="avares://Ultimate_Gshop/Resources/frame.png"
											   Width="40" Height="40"
											   Stretch="Fill"/>
										<Image x:Name="DetailGiftIcon"
											   Width="24" Height="24"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Center"/>
									</Grid>

									<!-- Ícone com GiftName -->
									<TextBlock Grid.Column="1"
											   x:Name="DetailGiftName"
											   TextWrapping="Wrap"
											   FontSize="13"
											   HorizontalAlignment="Center"
											   FontWeight="Bold"
											   Margin="5,0"
											   Foreground="White"/>
								</Grid>
								<Grid ColumnDefinitions="*,*" ColumnSpacing="4">
									<!-- GiftID -->
									<controls:FloatingLabelTextBox
													Grid.Column="0"
													x:Name="DetailGiftID"
													Label="Gift ID"
													IsEnabled="False"
													ContentType="Number"/>
									<!-- GiftAmount -->
									<controls:FloatingLabelTextBox
													Grid.Column="1"
													x:Name="DetailGiftAmount"
													Label="Gift Amount"
													IsEnabled="False"
													ContentType="Number"/>
								</Grid>
								<Grid ColumnDefinitions="*,*" ColumnSpacing="4">
									<!-- GiftPrice -->
									<controls:FloatingLabelTextBox
													Grid.Column="0"
													x:Name="DetailGiftPrice"
													Label="Gift Price"
													IsEnabled="False"
													ContentType="Number"/>
									<!-- GiftTime -->
									<controls:FloatingLabelTextBox
													Grid.Column="1"
													x:Name="DetailGiftTime"
													Label="Gift Time"
													IsEnabled="False"
													ContentType="Number"/>
								</Grid>
							</StackPanel>
						</Border>

						<!-- Reserve 1, 2 e 3 -->
						<Grid Width="280" ColumnDefinitions="*,*,*" ColumnSpacing="4">
							<!-- Reserve1 -->
							<controls:FloatingLabelTextBox
								Grid.Column="0"
								x:Name="DetailReserve1"
								Label="Reserve1"
								IsEnabled="False"
								ContentType="Number"/>

							<!-- Reserve2 -->
							<controls:FloatingLabelTextBox
								x:Name="DetailReserve2"
								Grid.Column="1"
								Label="Reserve2"
								IsEnabled="False"
								ContentType="Number"/>

							<!-- Reserve3 -->
							<controls:FloatingLabelTextBox
								Grid.Column="2"
								x:Name="DetailReserve3"
								Label="Reserve3"
								IsEnabled="False"
								ContentType="Number"/>
						</Grid>

						<!-- Reserve 4, 5 e 6 -->
						<Grid Width="280" ColumnDefinitions="*,*,*" ColumnSpacing="4">
							<!-- Reserve4 -->
							<controls:FloatingLabelTextBox
								Grid.Column="0"
								x:Name="DetailReserve4"
								Label="Reserve4"
								IsEnabled="False"
								ContentType="Number"/>

							<!-- Reserve5 -->
							<controls:FloatingLabelTextBox
								x:Name="DetailReserve5"
								Grid.Column="1"
								Label="Reserve5"
								IsEnabled="False"
								ContentType="Number"/>

							<!-- Reserve6 -->
							<controls:FloatingLabelTextBox
								Grid.Column="2"
								x:Name="DetailReserve6"
								Label="Reserve6"
								IsEnabled="False"
								ContentType="Number"/>
						</Grid>
						<!-- Owner List -->
						<Border Background="#344c51"
								BorderBrush="#5d5737"
								BorderThickness="1"
								CornerRadius="4"
								Padding="10"
								Width="280">

							<StackPanel Spacing="10">

								<!-- Título da seção -->
								<TextBlock Text="Owner NPCs"
										   FontWeight="Bold"
										   Foreground="White"
										   FontSize="13"
										   Margin="0,0,0,4"/>

								<!-- Grid de adição -->
								<Grid ColumnDefinitions="*,Auto"
									  ColumnSpacing="4">
									<controls:FloatingLabelTextBox
										x:Name="DetailOwnerAdd"
										Label="Owner NPC"
										IsEnabled="False"
										ContentType="Number"
										KeyDown="DetailOwnerAdd_KeyDown"/>

									<Button Grid.Column="1"
											x:Name="DetailOwnerAddButton"
											Width="50" Height="50"
											Margin="0" Padding="0"
											Background="Transparent"
											BorderBrush="Transparent"
											IsDefault="False"
											Opacity="0.25"
											IsEnabled="False"
											Click="AddOwner_Click">
										<Image Source="avares://Ultimate_Gshop/Resources/btn_add.png"/>
									</Button>
								</Grid>

								<!-- Lista de owners com borda própria -->
								<Border Background="#2b3d41"
										BorderBrush="#5d5737"
										BorderThickness="1"
										CornerRadius="4"
										Padding="6">

									<StackPanel>
										<!-- Cabeçalho -->
										<Grid ColumnDefinitions="48,1,*,1,59"
											  Margin="0,0,0,4">
											<TextBlock Text="ID"
													   FontSize="11"
													   FontWeight="DemiBold"
													   Foreground="White"
													   VerticalAlignment="Center"
													   Margin="7,0,0,0"/>

											<Border Grid.Column="1" Width="1" Background="#5d5737" Margin="4,0"/>

											<TextBlock Grid.Column="2"
													   Text="Name"
													   FontSize="11"
													   FontWeight="DemiBold"
													   Foreground="White"
													   VerticalAlignment="Center"
													   Margin="5,0,0,0"/>

											<Border Grid.Column="3" Width="1" Background="#5d5737" Margin="4,0"/>

											<TextBlock Grid.Column="4"
													   Text="Actions"
													   FontSize="11"
													   FontWeight="DemiBold"
													   Foreground="White"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
										</Grid>

										<!-- Lista -->
										<Border Background="#2b3d41"
												BorderBrush="#5d5737"
												BorderThickness="1"
												CornerRadius="4"
												Padding="6">
											<ItemsControl x:Name="DetailOwnerList">
												<ItemsControl.Resources>
													<x:Boolean x:Key="IsEnableDetailOwnerRemoveButton">True</x:Boolean>
													<x:Double x:Key="OpacityDetailOwnerRemoveButton">0.8</x:Double>
												</ItemsControl.Resources>

												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<StackPanel/>
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>

												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border BorderBrush="#5d5737" BorderThickness="0,1,0,0" Padding="2,6">
															<Grid ColumnDefinitions="40,1,*,1,50"
																  VerticalAlignment="Center">

																<!-- ID -->
																<TextBlock Text="{Binding DetailOwnerID}"
																		   Foreground="White"
																		   FontSize="11"
																		   VerticalAlignment="Center"
																		   HorizontalAlignment="Left"/>

																<!-- Linha vertical entre ID e Name -->
																<Border Grid.Column="1" Width="1" Background="#5d5737" Margin="4,0"/>

																<!-- Name -->
																<TextBlock Grid.Column="2"
																		   Text="{Binding DetailOwnerName}"
																		   Foreground="White"
																		   FontSize="11"
																		   VerticalAlignment="Center"
																		   HorizontalAlignment="Left"/>

																<!-- Linha vertical entre Name e Ações -->
																<Border Grid.Column="3" Width="1" Background="#5d5737" Margin="4,0"/>

																<!-- Botão remover -->
																<Button Grid.Column="4"
																		Width="50" Height="50"
																		Margin="0" Padding="0"
																		Background="Transparent"
																		BorderBrush="Transparent"
																		Opacity="{StaticResource OpacityDetailOwnerRemoveButton}"
																		IsEnabled="{StaticResource IsEnableDetailOwnerRemoveButton}"
																		Click="RemoveOwner_Click"
																		Tag="{Binding DetailOwnerID}"
																		HorizontalAlignment="Center"
																		VerticalAlignment="Center">
																	<Image Source="avares://Ultimate_Gshop/Resources/btn_remove.png"/>
																</Button>
															</Grid>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</Border>
									</StackPanel>
								</Border>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>
				<StackPanel Grid.Row="1"
							Orientation="Horizontal"
							HorizontalAlignment="Center"
							Margin="0,-7,0,10"
							Spacing="1">

					<!-- Botão Novo -->
					<Button x:Name="DetailNewButton"
							Width="85"
							Margin="0,10" Padding="0"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Click="DetailNew_Click">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Novo" Foreground="White" FontSize="12" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<!-- Botão Editar -->
					<Button x:Name="DetailEditButton"
							Width="85"
							Margin="15,10" Padding="0"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Click="DetailEdit_Click">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Editar" Foreground="White" FontSize="12" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<!-- Botão Excluir -->
					<Button x:Name="DetailDeleteButton"
							Width="85"
							Margin="0,10" Padding="0"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Click="DetailDelete_Click">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Excluir" Foreground="White" FontSize="12" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<!-- Botão Salvar -->
					<Button x:Name="DetailSaveButton"
							Width="85"
							Margin="10" Padding="0"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Click="DetailSave_Click"
							IsVisible="False">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Salvar" Foreground="White" FontSize="12" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<!-- Botão Desfazer -->
					<Button x:Name="DetailUndoButton"
							Width="85"
							Margin="10" Padding="0"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Click="DetailUndo_Click"
							IsVisible="False">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Desfazer" Foreground="White" FontSize="12" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>
				</StackPanel>

			</Grid>
		</Grid>

		<!-- Botão de fechar -->
		<Button Width="40" Height="40"
				Margin="0,90,80,0" Padding="0"
				Background="Transparent"
				BorderBrush="Transparent"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Opacity="0.9"
				Click="CloseButton_Click">
			<Image Source="avares://Ultimate_Gshop/Resources/btn_close.png"/>
		</Button>

		<!-- Área transparente para arrastar a janela - Ultimate_Gshop -->
		<Border Background="Transparent"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Top"
				Width="250"
				Height="50"
				Margin="0,35,0,0"
				PointerPressed="TopDrag_PointerPressed">

			<TextBlock Text="Ultimate Gshop"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           FontSize="24"
		   FontWeight="Bold"
           Foreground="#ebb935"/>
		</Border>
	</Grid>

</Window>
