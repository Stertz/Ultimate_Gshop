<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ultimate_Gshop"
		xmlns:itens="clr-namespace:Ultimate_Gshop.Itens"
		xmlns:controls="clr-namespace:Ultimate_Gshop.Views.UserControls"
        x:Class="Ultimate_Gshop.MainWindow"
        Title="Ultimate_Gshop"
        Width="1024" Height="760"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
		Icon="avares://Ultimate_Gshop/Resources/icon_gshop.ico"
        Background="Transparent">


	<Grid>
		<!-- Sua imagem de fundo -->
		<Image Source="avares://Ultimate_Gshop/Resources/bg.png"
               Stretch="Fill"/>

		<!-- Nav Button -->
		<Button Width="60"
				Height="60"
				Background="Transparent"
				BorderBrush="Transparent"
				HorizontalAlignment="Left"
				Opacity="0.95"
				VerticalAlignment="Top"
				Margin="75,85,0,0"
				Click="NavButton_Click">
			<Image Source="avares://Ultimate_Gshop/Resources/menu.png"
				   Stretch="Uniform"/>
		</Button>

		<!-- Category Panel -->
		<Grid>
			<ItemsControl x:Name="CategoryList"
						  HorizontalAlignment="Center"
						  VerticalAlignment="Top"
						  Margin="0,155,0,0">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Center"
									Spacing="10"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border CornerRadius="4"
								BorderThickness="0"
								BorderBrush="Transparent"
								Margin="2"
								BoxShadow="0 0 10 0 Transparent">
							<Grid Width="100" Height="60" PointerPressed="OnCategoryClick">
								<Image Source="avares://Ultimate_Gshop/Resources/category_frame.png"
									   Opacity="0.60"
									   Stretch="Fill"/>

								<!-- Conteúdo do botão -->
								<StackPanel VerticalAlignment="Center"
											HorizontalAlignment="Center"
											Spacing="2">
									<!-- Ícone -->
									<Image Source="avares://Ultimate_Gshop/Resources/question_mark.png"
										   Width="24"
										   Height="24"
										   Stretch="Uniform"/>

									<!-- Texto -->
									<TextBlock Text="{Binding Title}"
											   HorizontalAlignment="Center"
											   Foreground="White"
											   FontWeight="Bold"
											   FontSize="14"
											   TextAlignment="Center"/>
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>

				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- SubCategory Panel -->
			<ItemsControl x:Name="SubCategoryList"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,215,0,0">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal"
								   HorizontalAlignment="Center"
								   ItemWidth="80"
								   ItemHeight="40"
								   Margin="5"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border CornerRadius="4"
								BorderThickness="0"
								BorderBrush="Transparent"
								Margin="2"
								BoxShadow="0 0 10 0 Transparent">
							<Grid Width="70" Height="30" PointerPressed="OnSubCategoryClick">
								<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
									   Opacity="0.85"
									   Stretch="Fill"/>
								<TextBlock Text="{Binding}"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Bottom"
										   Margin="0,0,0,7"
										   Foreground="White"
										   FontWeight="DemiBold"
										   FontSize="12"
										   TextAlignment="Center"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Grid>

		<!-- Grid Pesquisa e Lista de Itens -->
		<Grid Width="540" Height="470" Margin="70,230,0,0" HorizontalAlignment="Left">
			<!-- Background -->
			<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
				   Stretch="Fill"
				   Opacity="0.85"/>

			<!-- Barra de pesquisa -->
			<Grid HorizontalAlignment="Left"
				  VerticalAlignment="Top"
				  Width="420"
				  Height="25"
				  Margin="40,35,0,0">
				<!-- Imagem de fundo da barra -->
				<Image Source="avares://Ultimate_Gshop/Resources/search_bar.png"
					   Stretch="Fill"/>
				<!-- Campo de texto -->
				<TextBox x:Name="SearchBox"
						 KeyDown="SearchBox_KeyDown"
						 Background="Transparent"
						 BorderThickness="0"
						 Foreground="White"
						 FontSize="14"
						 VerticalContentAlignment="Center"
						 Padding="10,0">
					<TextBox.Styles>
						<Style Selector="TextBox:pointerover /template/ Border">
							<Setter Property="BorderBrush" Value="Transparent"/>
							<Setter Property="Background" Value="Transparent"/>
						</Style>
						<Style Selector="TextBox:focus /template/ Border">
							<Setter Property="BorderBrush" Value="Transparent"/>
							<Setter Property="Background" Value="Transparent"/>
						</Style>
					</TextBox.Styles>
				</TextBox>
			</Grid>

			<!-- Icone de pesquisa -->
			<Button Width="40"
					Height="40"
					HorizontalAlignment="Right"
					VerticalAlignment="Top"
					Margin="0,30,40,0"
					Background="Transparent"
					BorderBrush="Transparent"
					Click="SearchIcon_Click">
				<Image Source="avares://Ultimate_Gshop/Resources/search.png"
					   Stretch="Fill"
					   Width="35"
					   Height="35"/>
			</Button>

			<!-- ScrollViewer sobre a imagem, relativo ao Grid -->
			<ScrollViewer Width="460"
						  Height="380"
						  Margin="0,70,0,0"
						  VerticalAlignment="Top"
						  VerticalScrollBarVisibility="Visible">
				<ItemsRepeater x:Name="ItemList">
					<ItemsRepeater.Layout>
						<UniformGridLayout Orientation="Horizontal"
										   MinRowSpacing="5"
										   MinColumnSpacing="5"/>
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate>
							<Border x:Name="CardBorder"
									CornerRadius="4"
									BorderThickness="0"
									BorderBrush="Transparent"
									Margin="2"
									BoxShadow="0 0 10 0 Transparent">
								<Grid Width="218" Height="92" Margin="0.8"
									  PointerPressed="OnItemCard_PointerPressed" Tag="{Binding Tag}">

									<Image Source="avares://Ultimate_Gshop/Resources/item_slot_frame.png"
										   Stretch="Fill"/>

									<Image Source="{Binding IconBitmap}"
										   Width="31" Height="31"
										   HorizontalAlignment="Left"
										   VerticalAlignment="Top"
										   Margin="13,42,0,0"/>

									<TextBlock Text="{Binding Name}"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Top"
											   Margin="0,7,0,0"
											   FontSize="11"
											   FontWeight="Bold"
											   Foreground="White"/>

									<TextBlock Text="{Binding Id, StringFormat=ID: {0}}"
											   HorizontalAlignment="Left"
											   VerticalAlignment="Top"
											   Margin="60,34,0,0"
											   FontSize="11"
											   FontWeight="DemiBold"
											   Foreground="White"/>

									<TextBlock Text="{Binding Price, StringFormat={}{0} GOLD}"
											   HorizontalAlignment="Left"
											   VerticalAlignment="Top"
											   Margin="60,48.5,0,0"
											   FontSize="10.5"
											   FontWeight="DemiBold"
											   Foreground="#ebb935"/>

									<TextBlock Text="{Binding LimitPeriod}"
											   HorizontalAlignment="Right"
											   VerticalAlignment="Top"
											   Margin="0,34,10,0"
											   FontSize="11"
											   FontWeight="DemiBold"
											   Foreground="White"/>

									<TextBlock Text="{Binding Amount, StringFormat={}{0} Qtd}"
											   HorizontalAlignment="Right"
											   VerticalAlignment="Top"
											   Margin="0,48.5,10,0"
											   FontSize="10.5"
											   FontWeight="DemiBold"
											   Foreground="DarkKhaki"/>

									<!-- Botão Copiar -->
									<Button Width="67.5"
											Height="35"
											Margin="45,0,0,0"
											Background="Transparent"
											BorderBrush="Transparent"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Opacity="0.9"
											Click="ItemCopyButton_Click"
											Tag="{Binding Tag}">
										<Grid>
											<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
											<TextBlock Text="Copiar"
													   Foreground="White"
													   FontSize="8"
													   FontWeight="Bold"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
										</Grid>
									</Button>

									<!-- Botão Editar -->
									<Button Width="67.5"
											Height="35"
											Margin="97.5,0,0,0"
											Background="Transparent"
											BorderBrush="Transparent"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Opacity="0.9"
											Click="ItemEditButton_Click"
											Tag="{Binding Tag}">
										<Grid>
											<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
											<TextBlock Text="Editar"
													   Foreground="White"
													   FontSize="8"
													   FontWeight="Bold"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
										</Grid>
									</Button>

									<!-- Botão Excluir -->
									<Button Width="67.5"
											Height="35"
											Margin="150,0,0,0"
											Background="Transparent"
											BorderBrush="Transparent"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Opacity="0.9"
											Click="ItemDeleteButton_Click"
											Tag="{Binding Tag}">
										<Grid>
											<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
											<TextBlock Text="Excluir"
													   Foreground="White"
													   FontSize="8"
													   FontWeight="Bold"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
										</Grid>
									</Button>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>
			</ScrollViewer>
		</Grid>

		<!-- Detalhe de Itens -->
		<Grid HorizontalAlignment="Right"
			  Width="340"
			  Height="470"
			  Margin="0,230,70,0"
			  Opacity="0.9">

			<!-- Fundo -->
			<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
				   Stretch="Fill"/>

			<!-- Container geral com conteúdo e botões -->
			<Grid>
				<Grid.RowDefinitions>
					<!-- Conteúdo com scroll -->
					<RowDefinition Height="*" />
					<!-- Área fixa para os botões -->
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<StackPanel x:Name="DetailPanel"
							Margin="0,20,0,0"
							Spacing="6">
					<!-- Botão engrenagem sobreposto no canto superior direito -->
					<Canvas HorizontalAlignment="Right" VerticalAlignment="Top"
							Width="65" Height="0">
						<Button Width="55"
								Height="55"
								Background="Transparent"
								BorderBrush="Transparent">
							<Image Source="avares://Ultimate_Gshop/Resources/settings.png"
								   Stretch="Uniform"/>
						</Button>
					</Canvas>

					<!-- Ícone com moldura -->
					<Grid HorizontalAlignment="Center" Margin="0,15,0,15">
						<Image Source="avares://Ultimate_Gshop/Resources/frame.png"
							   Width="100" Height="100"
							   Stretch="Fill"/>
						<Image x:Name="DetailIcon"
							   Width="60" Height="60"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"/>
					</Grid>

					<!-- ID + Amount -->
					<Grid Width="280" ColumnDefinitions="*,Auto" ColumnSpacing="4">
						<!-- ID (somente números) -->
						<controls:FloatingLabelTextBox
							x:Name="DetailID"
							Label="ID"
							IsEnabled="True"
							ContentType="Number"/>

						<!-- Amount -->
						<controls:FloatingLabelTextBox
							x:Name="DetailAmount"
							Grid.Column="1"
							Label="Amount"
							Width="140"
							IsEnabled="True"
							ContentType="Number"/>
					</Grid>

					<!-- Nome -->
					<controls:FloatingLabelTextBox
							x:Name="DetailName"
							Width="280"
							Label="Name"
							IsEnabled="True"/>

					<!-- Time Limit + Avail Frequency -->
					<Grid Width="280" ColumnDefinitions="*,*" ColumnSpacing="4">
						<!-- Time Limit -->
						<controls:FloatingLabelTextBox
							x:Name="DetailLimitPeriod"
							Label="Limit Period"
							IsEnabled="True"
							ContentType="Number"/>

						<!-- Avail Frequency -->
						<controls:FloatingLabelTextBox
							Grid.Column="1"
							x:Name="DetailAvailFrequency"
							Label="Avail Frequency"
							IsEnabled="True"
							ContentType="Number"/>
					</Grid>

					<!-- Descrição com alternância -->
					<Border Background="#344c51"
							BorderBrush="#5d5737"
							BorderThickness="1"
							CornerRadius="4"
							Width="280"
							Height="110">
						<Grid>
							<!-- Editor (TextBox com texto bruto, usado para editar) -->
							<TextBox x:Name="DetailExplanationEditor"
									 Background="Transparent"
									 BorderBrush="Transparent"
									 Foreground="White"
									 CornerRadius="4"
									 Padding="6,3"
									 FontSize="12"
									 TextWrapping="Wrap"
									 AcceptsReturn="True"
									 Watermark="Descrição"
									 IsVisible="False">
								<TextBox.Styles>
									<Style Selector="TextBox">
										<Setter Property="Foreground" Value="White"/>
									</Style>
									<!-- Hover -->
									<Style Selector="TextBox:pointerover /template/ Border">
										<Setter Property="Background" Value="#3A5055"/>
										<Setter Property="BorderBrush" Value="#5d5737"/>
									</Style>
									<!-- Focus -->
									<Style Selector="TextBox:focus /template/ Border">
										<Setter Property="Background" Value="#415b60"/>
										<Setter Property="BorderBrush" Value="#a59a69"/>
									</Style>
								</TextBox.Styles>
							</TextBox>

							<!-- Visual (TextBlock com cores, usado só para visualizar) -->
							<ScrollViewer x:Name="DetailExplanationPreview"
										  Background="Transparent"
										  FontSize="12">
								<TextBlock x:Name="DetailExplanation"
										   TextWrapping="Wrap"
										   Padding="6,3"
										   Background="Transparent"
										   Foreground="White"/>
							</ScrollViewer>

							<!-- Preview - Unpreview -->
							<Canvas HorizontalAlignment="Right" VerticalAlignment="Top"
									Width="50" Height="50"
									Margin="0,0,-9,0">
								<Button Width="42"
										Height="42"
										Background="Transparent"
										BorderBrush="Transparent"
										Click="PreviewToggle_Click">
									<Image x:Name="PreviewButtonIcon"
										   Source="avares://Ultimate_Gshop/Resources/preview.png"
										   Stretch="Uniform"/>
								</Button>
							</Canvas>

							<!-- Color Palette -->
							<Canvas HorizontalAlignment="Right" VerticalAlignment="Top"
									Width="50" Height="50"
									Margin="0,27,-10,0">
								<Button x:Name="PaletteButton"
										Width="40" Height="40"
										IsVisible="False"
										Background="Transparent"
										BorderBrush="Transparent"
										Click="PaletteButton_Click">
									<Image Source="avares://Ultimate_Gshop/Resources/color_palette.png"
										   Stretch="Uniform"/>
								</Button>
							</Canvas>

						</Grid>
					</Border>
				</StackPanel>

				<!-- Botões fixos -->
				<StackPanel Grid.Row="1"
							Orientation="Horizontal"
							HorizontalAlignment="Center"
							Margin="0,-7,0,10"
							Spacing="1">
					<!-- Botão Novo -->
					<Button Width="100"
							Height="60"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Click="DetailNew_Click">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Novo"
									   Foreground="White"
									   FontSize="12"
									   FontWeight="Bold"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<!-- Botão Editar -->
					<Button Width="100"
							Height="60"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Click="DetailEdit_Click">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Editar"
									   Foreground="White"
									   FontSize="12"
									   FontWeight="Bold"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<!-- Botão Excluir -->
					<Button Width="100"
							Height="60"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Click="DetailDelete_Click">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Excluir"
									   Foreground="White"
									   FontSize="12"
									   FontWeight="Bold"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"/>
						</Grid>
					</Button>
				</StackPanel>
			</Grid>
		</Grid>

		<!-- Botão de fechar -->
		<Button Width="55"
				Height="55"
				Margin="0,90,80,0"
				Background="Transparent"
				BorderBrush="Transparent"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Opacity="0.9"
				Click="CloseButton_Click">
			<Image Source="avares://Ultimate_Gshop/Resources/btn_close.png"/>
		</Button>

		<!-- Área transparente para arrastar a janela - Ultimate_Gshop -->
		<Border Background="Transparent"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Top"
				Width="250"
				Height="50"
				Margin="0,35,0,0"
				PointerPressed="TopDrag_PointerPressed">

			<TextBlock Text="Ultimate Gshop"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           FontSize="24"
		   FontWeight="Bold"
           Foreground="#ebb935"/>
		</Border>
	</Grid>

</Window>
