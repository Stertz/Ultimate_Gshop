<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ultimate_Gshop"
		xmlns:itens="clr-namespace:Ultimate_Gshop.Itens"
		xmlns:controls="clr-namespace:Ultimate_Gshop.Views.UserControls"
        x:Class="Ultimate_Gshop.MainWindow"
        Title="Ultimate_Gshop"
        Width="1024" Height="760"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
		CanResize="False"
        Background="Transparent"
		Icon="avares://Ultimate_Gshop/Resources/icon_gshop.ico">


	<Grid>
		<!-- Sua imagem de fundo -->
		<Image Source="avares://Ultimate_Gshop/Resources/bg.png"
               Stretch="Fill"/>

		<!-- Nav Button -->
		<Button Width="45" Height="45"
				Margin="80,90,0,0" Padding="0"
				Background="Transparent"
				BorderBrush="Transparent"
				HorizontalAlignment="Left"
				Opacity="0.95"
				VerticalAlignment="Top"
				Click="NavButton_Click">
			<Image Source="avares://Ultimate_Gshop/Resources/menu.png"
				   Stretch="Uniform"/>
		</Button>

		<!-- Undo Arrow -->
		<Button x:Name="UndoButton"
				Width="42" Height="42"
				Margin="130,92,0,0" Padding="0"
				Background="Transparent"
				BorderBrush="Transparent"
				HorizontalAlignment="Left"
				Opacity="0.25"
				VerticalAlignment="Top"
				Click="Undo_Click">
			<Image Source="avares://Ultimate_Gshop/Resources/undo_arrow.png"
				   Stretch="Uniform"/>
		</Button>

		<!-- Redo Arrow -->
		<Button x:Name="RedoButton"
				Width="42" Height="42"
				Margin="170,92,0,0" Padding="0"
				Background="Transparent"
				BorderBrush="Transparent"
				HorizontalAlignment="Left"
				Opacity="0.25"
				VerticalAlignment="Top"
				Click="Redo_Click">
			<Image Source="avares://Ultimate_Gshop/Resources/redo_arrow.png"
				   Stretch="Uniform"/>
		</Button>

		<!-- Category Panel -->
		<Grid>
			<ItemsControl x:Name="CategoryList"
						  HorizontalAlignment="Center"
						  VerticalAlignment="Top"
						  Margin="0,155,0,0">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Center"
									Spacing="10"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border CornerRadius="4"
								BorderThickness="0"
								BorderBrush="Transparent"
								Margin="2"
								BoxShadow="0 0 10 0 Transparent">
							<Grid Width="100" Height="60" PointerPressed="OnCategoryClick">
								<Image Source="avares://Ultimate_Gshop/Resources/category_frame.png"
									   Opacity="0.60"
									   Stretch="Fill"/>

								<!-- Conteúdo do botão -->
								<StackPanel VerticalAlignment="Center"
											HorizontalAlignment="Center"
											Spacing="2">
									<!-- Ícone -->
									<Image Source="avares://Ultimate_Gshop/Resources/question_mark.png"
										   Width="24"
										   Height="24"
										   Stretch="Uniform"/>

									<!-- Texto -->
									<TextBlock Text="{Binding Title}"
											   HorizontalAlignment="Center"
											   Foreground="White"
											   FontWeight="Bold"
											   FontSize="14"
											   TextAlignment="Center"/>
								</StackPanel>
								<Grid.ContextMenu>
									<ContextMenu>
										<MenuItem Header="Rename" Click="OnRenameCategoryClick"/>
										<MenuItem Header="Reset"  Click="OnResetCategoryClick"/>
									</ContextMenu>
								</Grid.ContextMenu>



							</Grid>
						</Border>
					</DataTemplate>

				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- SubCategory Panel -->
			<ItemsControl x:Name="SubCategoryList"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,215,0,0">

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel Orientation="Horizontal"
								   HorizontalAlignment="Center"
								   ItemWidth="80"
								   ItemHeight="40"
								   Margin="5"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border CornerRadius="4"
								BorderThickness="0"
								BorderBrush="Transparent"
								Margin="2"
								BoxShadow="0 0 10 0 Transparent">
							<Grid Width="70" Height="30" PointerPressed="OnSubCategoryClick">
								<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
									   Opacity="0.85"
									   Stretch="Fill"/>
								<TextBlock Text="{Binding}"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Bottom"
										   Margin="0,0,0,7"
										   Foreground="White"
										   FontWeight="DemiBold"
										   FontSize="12"
										   TextAlignment="Center"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Grid>

		<!-- Grid Pesquisa e Lista de Itens -->
		<Grid Width="540" Height="470" Margin="70,230,0,0" HorizontalAlignment="Left">
			<!-- Background -->
			<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
				   Stretch="Fill"
				   Opacity="0.85"/>

			<controls:FloatingLabelTextBox
				x:Name="SearchBox"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Width="447"
				Label="Search"
				FontSize="14"
				Foreground="White"
				Margin="42,35,0,0"/>

			<!-- Items List -->
			<controls:ItemsListControl x:Name="ItemsList"
                           Width="460" Height="370"
                           Margin="0,80,0,0"
                           VerticalAlignment="Top"/>
		</Grid>

		<!-- Detalhe de Itens -->
		<Grid HorizontalAlignment="Right"
			  Width="340"
			  Height="470"
			  Margin="0,230,70,0"
			  Opacity="0.9">

			<!-- Fundo -->
			<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
				   Stretch="Fill"/>

			<!-- Container geral com conteúdo e botões -->
			<Grid HorizontalAlignment="Center">
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- ====== ESTILO DAS ABAS (centralizado + spacing + selected fg) ====== -->
				<Grid.Styles>
					<!-- TabControl do painel -->
					<Style Selector="TabControl#DetailPanel">
						<Setter Property="TabStripPlacement" Value="Top"/>
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="Padding" Value="0"/>
					</Style>

					<!-- Conteúdo da página -->
					<Style Selector="TabControl#DetailPanel /template/ ContentPresenter">
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="Padding" Value="0"/>
					</Style>

					<!-- Cabeçalho da aba -->
					<Style Selector="TabControl#DetailPanel TabItem">
						<Setter Property="FontSize" Value="12"/>
						<Setter Property="FontWeight" Value="DemiBold"/>
						<Setter Property="Foreground" Value="#d9e2df"/>
						<Setter Property="Padding" Value="0"/>
						<!-- cor padrão -->
						<Setter Property="Margin" Value="75,0,-60,-5"/>
						<Setter Property="HorizontalAlignment" Value="Center"/>
						<!-- espaçamento entre abas -->
						<Setter Property="MinWidth" Value="80"/>
						<Setter Property="Template">
							<ControlTemplate>
								<Border CornerRadius="7"
										BorderThickness="1"
										Background="#344c51"
										Height="30"
										BorderBrush="#5d5737"
										BoxShadow="0 1 0 0 #0f1a1d, 0 0 10 0 #00000055">
									<!-- Renderiza o Header como texto e aplica a cor da aba -->
									<TextBlock Text="{TemplateBinding Header}"
											   Foreground="{TemplateBinding Foreground}"
											   FontSize="{TemplateBinding FontSize}"
											   FontWeight="{TemplateBinding FontWeight}"
											   HorizontalAlignment="Center"
											   Padding="0" Margin="0"
											   VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Setter>
					</Style>

					<!-- Hover -->
					<Style Selector="TabControl#DetailPanel TabItem:pointerover /template/ Border">
						<Setter Property="Background" Value="#3d5a60"/>
						<Setter Property="BorderBrush" Value="#a59a69"/>
					</Style>

					<!-- Selecionada: muda também a cor da FONTE -->
					<Style Selector="TabControl#DetailPanel TabItem:selected">
						<Setter Property="Foreground" Value="#fff4c2"/>
						<!-- fonte da aba ativa -->
					</Style>
					<Style Selector="TabControl#DetailPanel TabItem:selected /template/ Border">
						<Setter Property="Background" Value="#415b60"/>
						<Setter Property="BorderBrush" Value="#ebb935"/>
						<!-- dourado vivo -->
						<Setter Property="BoxShadow" Value="0 0 0 1 #0f1a1d inset, 0 0 12 0 #00000088"/>
					</Style>
				</Grid.Styles>

				<!-- ====== CONTEÚDO EM ABAS ====== -->
				<TabControl x:Name="DetailPanel" Grid.Row="0" Margin="0,20,0,0" Width="320">

					<!-- ABA 1: GERAL -->
					<TabItem Header="Principal">
						<ScrollViewer HorizontalScrollBarVisibility="Disabled"
									  VerticalScrollBarVisibility="Auto">
							<StackPanel Spacing="6" Margin="0,20,0,0">

								<!-- Ícone com moldura -->
								<Grid HorizontalAlignment="Center" Margin="0,0,0,15">
									<Image Source="avares://Ultimate_Gshop/Resources/frame.png"
										   Width="100" Height="100"
										   Stretch="Fill"/>
									<Image x:Name="DetailIcon"
										   Width="60" Height="60"
										   HorizontalAlignment="Center"
										   VerticalAlignment="Center"/>
								</Grid>

								<!-- ID + Amount -->
								<Grid Width="280" ColumnDefinitions="*,*" ColumnSpacing="4">
									<!-- ID (somente números) -->
									<controls:FloatingLabelTextBox
										x:Name="DetailID"
										Label="ID"
										IsEnabled="False"
										InputMode="Number"/>

									<!-- Amount -->
									<controls:FloatingLabelTextBox
										x:Name="DetailAmount"
										Grid.Column="1"
										Label="Amount"
										IsEnabled="False"
										InputMode="Number"/>
								</Grid>

								<!-- Nome -->
								<controls:FloatingLabelTextBox
										x:Name="DetailName"
										Width="280"
										Label="Name"
										IsEnabled="False"/>

								<!-- Time Limit + Avail Frequency -->
								<Grid Width="280" ColumnDefinitions="*,*" ColumnSpacing="4">
									<!-- Time Limit -->
									<controls:FloatingLabelTextBox
										x:Name="DetailLimitPeriod"
										Label="Limit Period"
										IsEnabled="False"
										InputMode="Number"/>

									<!-- Avail Frequency -->
									<controls:FloatingLabelTextBox
										Grid.Column="1"
										x:Name="DetailAvailFrequency"
										Label="Avail Frequency"
										IsEnabled="False"
										InputMode="Number"/>
								</Grid>

								<!-- Descrição com alternância -->
								<controls:ExplanationEditorControl
								   x:Name="ExplanationEditorControl"
								   Width="280"
								   Height="110"/>

								<!-- Grid de Class +  -->
								<Grid ColumnDefinitions="*,auto"
									  ColumnSpacing="4"
									  Width="280">
									<!-- Class -->
									<controls:StyledComboBox
										x:Name="DetailClassComboBox"
										LabelText="Class"
										IsEnabled="False"
										HorizontalAlignment="Stretch"/>

									<!-- Sale -->
									<Button Grid.Column="1"
											x:Name="DetailSaleButton"
											Width="45" Height="45"
											Background="Transparent"
											BorderBrush="Transparent"
											IsDefault="False"
											Margin="0,5,0,0" Padding="0"
											Opacity="0.25"
											IsEnabled="False"
											Click="SaleEditor_Click">
										<Image Source="avares://Ultimate_Gshop/Resources/btn_sale.png"/>
									</Button>
								</Grid>

								<!-- Category + SubCategory -->
								<Grid Width="280" ColumnDefinitions="*,*" ColumnSpacing="4">
									<!-- ComboBox para selecionar categoria -->
									<controls:StyledComboBox
										x:Name="DetailCategoryComboBox"
										LabelText="Category"
										IsEnabled="False"/>

									<!-- ComboBox para selecionar categoria -->
									<controls:StyledComboBox
										Grid.Column="1"
										x:Name="DetailSubCategoryComboBox"
										LabelText="SubCategory"
										IsEnabled="False"/>
								</Grid>
							</StackPanel>
						</ScrollViewer>
					</TabItem>

					<!-- ABA 2: GIFT & EXTRAS -->
					<TabItem Header="Extras">
						<ScrollViewer HorizontalScrollBarVisibility="Disabled"
									  VerticalScrollBarVisibility="Auto">
							<StackPanel Spacing="6" Margin="0,20,0,0">
								<!-- Gift -->
								<Border Background="#344c51"
										BorderBrush="#5d5737"
										BorderThickness="1"
										CornerRadius="4"
										Padding="10"
										Width="280">
									<StackPanel>
										<Grid ColumnDefinitions="auto,*" ColumnSpacing="4">
											<!-- Ícone com moldura -->
											<Grid HorizontalAlignment="Left" Margin="0,0,0,10">
												<Image Source="avares://Ultimate_Gshop/Resources/frame.png"
													   Width="40" Height="40"
													   Stretch="Fill"/>
												<Image x:Name="DetailGiftIcon"
													   Width="24" Height="24"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"/>
											</Grid>

											<!-- Ícone com GiftName -->
											<TextBlock Grid.Column="1"
													   x:Name="DetailGiftName"
													   TextWrapping="Wrap"
													   FontSize="13"
													   HorizontalAlignment="Center"
													   FontWeight="Bold"
													   Margin="5,0"
													   Foreground="White"/>
										</Grid>
										<Grid ColumnDefinitions="*,*" ColumnSpacing="4">
											<!-- GiftID -->
											<controls:FloatingLabelTextBox
															Grid.Column="0"
															x:Name="DetailGiftID"
															Label="Gift ID"
															IsEnabled="False"
															InputMode="Number"
															KeyDown="DetailGiftID_KeyDown"
															LostFocus="DetailGiftID_LostFocus"/>
											<!-- GiftAmount -->
											<controls:FloatingLabelTextBox
															Grid.Column="1"
															x:Name="DetailGiftAmount"
															Label="Gift Amount"
															IsEnabled="False"
															InputMode="Number"/>
										</Grid>
										<Grid ColumnDefinitions="*,*" ColumnSpacing="4">
											<!-- GiftPrice -->
											<controls:FloatingLabelTextBox
															Grid.Column="0"
															x:Name="DetailGiftPrice"
															Label="Gift Price"
															IsEnabled="False"
															InputMode="Decimal"/>
											<!-- GiftTime -->
											<controls:FloatingLabelTextBox
															Grid.Column="1"
															x:Name="DetailGiftTime"
															Label="Gift Time"
															IsEnabled="False"
															InputMode="Number"/>
										</Grid>
									</StackPanel>
								</Border>

								<!-- Reserve 1, 2 e 3 -->
								<Grid Width="280" ColumnDefinitions="*,*,*" ColumnSpacing="4">
									<!-- Reserve1 -->
									<controls:FloatingLabelTextBox
										Grid.Column="0"
										x:Name="DetailReserve1"
										Label="Reserve1"
										IsEnabled="False"
										InputMode="Number"/>

									<!-- Reserve2 -->
									<controls:FloatingLabelTextBox
										x:Name="DetailReserve2"
										Grid.Column="1"
										Label="Reserve2"
										IsEnabled="False"
										InputMode="Number"/>

									<!-- Reserve3 -->
									<controls:FloatingLabelTextBox
										Grid.Column="2"
										x:Name="DetailReserve3"
										Label="Reserve3"
										IsEnabled="False"
										InputMode="Number"/>
								</Grid>

								<!-- Reserve 4, 5 e 6 -->
								<Grid Width="280" ColumnDefinitions="*,*,*" ColumnSpacing="4">
									<!-- Reserve4 -->
									<controls:FloatingLabelTextBox
										Grid.Column="0"
										x:Name="DetailReserve4"
										Label="Reserve4"
										IsEnabled="False"
										InputMode="Number"/>

									<!-- Reserve5 -->
									<controls:FloatingLabelTextBox
										x:Name="DetailReserve5"
										Grid.Column="1"
										Label="Reserve5"
										IsEnabled="False"
										InputMode="Number"/>

									<!-- Reserve6 -->
									<controls:FloatingLabelTextBox
										Grid.Column="2"
										x:Name="DetailReserve6"
										Label="Reserve6"
										IsEnabled="False"
										InputMode="Number"/>
								</Grid>
								<!-- Owner List -->
								<Border Background="#344c51"
										BorderBrush="#5d5737"
										BorderThickness="1"
										CornerRadius="4"
										Padding="10"
										Width="280">

									<StackPanel Spacing="10">

										<!-- Título da seção -->
										<TextBlock Text="Owner NPCs"
												   FontWeight="Bold"
												   Foreground="White"
												   FontSize="13"
												   Margin="0,0,0,4"/>

										<!-- Grid de adição -->
										<Grid ColumnDefinitions="*,Auto"
											  ColumnSpacing="4">
											<controls:FloatingLabelTextBox
												x:Name="DetailOwnerAdd"
												Label="Owner NPC"
												IsEnabled="False"
												InputMode="Number"
												KeyDown="DetailOwnerAdd_KeyDown"/>

											<Button Grid.Column="1"
													x:Name="DetailOwnerAddButton"
													Width="35" Height="35"
													Margin="0" Padding="0"
													Background="Transparent"
													BorderBrush="Transparent"
													IsDefault="False"
													Opacity="0.25"
													IsEnabled="False"
													Click="AddOwner_Click">
												<Image Source="avares://Ultimate_Gshop/Resources/btn_add.png"/>
											</Button>
										</Grid>

										<!-- Lista de owners com borda própria -->
										<Border Background="#2b3d41"
												BorderBrush="#5d5737"
												BorderThickness="1"
												CornerRadius="4"
												Padding="6">

											<StackPanel>
												<!-- Cabeçalho -->
												<Grid ColumnDefinitions="48,1,*,1,59"
													  Margin="0,0,0,4">
													<TextBlock Text="ID"
															   FontSize="11"
															   FontWeight="DemiBold"
															   Foreground="White"
															   VerticalAlignment="Center"
															   Margin="7,0,0,0"/>

													<Border Grid.Column="1" Width="1" Background="#5d5737" Margin="4,0"/>

													<TextBlock Grid.Column="2"
															   Text="Name"
															   FontSize="11"
															   FontWeight="DemiBold"
															   Foreground="White"
															   VerticalAlignment="Center"
															   Margin="5,0,0,0"/>

													<Border Grid.Column="3" Width="1" Background="#5d5737" Margin="4,0"/>

													<TextBlock Grid.Column="4"
															   Text="Actions"
															   FontSize="11"
															   FontWeight="DemiBold"
															   Foreground="White"
															   HorizontalAlignment="Center"
															   VerticalAlignment="Center"/>
												</Grid>

												<!-- Lista -->
												<Border Background="#2b3d41"
														BorderBrush="#5d5737"
														BorderThickness="1"
														CornerRadius="4"
														Padding="6">
													<ItemsControl x:Name="DetailOwnerList">
														<ItemsControl.Resources>
															<x:Boolean x:Key="IsEnableDetailOwnerRemoveButton">True</x:Boolean>
															<x:Double x:Key="OpacityDetailOwnerRemoveButton">0.8</x:Double>
														</ItemsControl.Resources>

														<ItemsControl.ItemsPanel>
															<ItemsPanelTemplate>
																<StackPanel/>
															</ItemsPanelTemplate>
														</ItemsControl.ItemsPanel>

														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<Border BorderBrush="#5d5737" BorderThickness="0,1,0,0" Padding="2,6">
																	<Grid ColumnDefinitions="40,1,*,1,50"
																		  VerticalAlignment="Center">

																		<!-- ID -->
																		<TextBlock Text="{Binding DetailOwnerID}"
																				   Foreground="White"
																				   FontSize="11"
																				   VerticalAlignment="Center"
																				   HorizontalAlignment="Left"/>

																		<!-- Linha vertical entre ID e Name -->
																		<Border Grid.Column="1" Width="1" Background="#5d5737" Margin="4,0"/>

																		<!-- Name -->
																		<TextBlock Grid.Column="2"
																				   Text="{Binding DetailOwnerName}"
																				   Foreground="White"
																				   FontSize="11"
																				   VerticalAlignment="Center"
																				   HorizontalAlignment="Left"/>

																		<!-- Linha vertical entre Name e Ações -->
																		<Border Grid.Column="3" Width="1" Background="#5d5737" Margin="4,0"/>

																		<!-- Botão remover -->
																		<Button Grid.Column="4"
																				Width="25" Height="25"
																				Margin="0" Padding="0"
																				Background="Transparent"
																				BorderBrush="Transparent"
																				Opacity="{StaticResource OpacityDetailOwnerRemoveButton}"
																				IsEnabled="{StaticResource IsEnableDetailOwnerRemoveButton}"
																				Click="RemoveOwner_Click"
																				Tag="{Binding DetailOwnerID}"
																				HorizontalAlignment="Center"
																				VerticalAlignment="Center">
																			<Image Source="avares://Ultimate_Gshop/Resources/btn_remove.png"/>
																		</Button>
																	</Grid>
																</Border>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</Border>
											</StackPanel>
										</Border>
									</StackPanel>
								</Border>
							</StackPanel>
						</ScrollViewer>
					</TabItem>
				</TabControl>
				<StackPanel Grid.Row="1"
							Orientation="Horizontal"
							HorizontalAlignment="Center"
							Margin="0,-7,0,10"
							Spacing="1">

					<!-- Botão Novo -->
					<Button x:Name="DetailNewButton"
							Width="85"
							Margin="0,10" Padding="0"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Click="DetailNew_Click">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Novo" Foreground="White" FontSize="12" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<!-- Botão Editar -->
					<Button x:Name="DetailEditButton"
							Width="85"
							Margin="15,10" Padding="0"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Click="DetailEdit_Click">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Editar" Foreground="White" FontSize="12" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<!-- Botão Excluir -->
					<Button x:Name="DetailDeleteButton"
							Width="85"
							Margin="0,10" Padding="0"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Click="DetailDelete_Click">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Excluir" Foreground="White" FontSize="12" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<!-- Botão Salvar -->
					<Button x:Name="DetailSaveButton"
							Width="85"
							Margin="10" Padding="0"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Click="DetailSave_Click"
							IsVisible="False">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Salvar" Foreground="White" FontSize="12" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>

					<!-- Botão Desfazer -->
					<Button x:Name="DetailUndoButton"
							Width="85"
							Margin="10" Padding="0"
							Background="Transparent"
							BorderBrush="Transparent"
							Opacity="0.9"
							Click="DetailUndo_Click"
							IsVisible="False">
						<Grid>
							<Image Source="avares://Ultimate_Gshop/Resources/btn.png"/>
							<TextBlock Text="Desfazer" Foreground="White" FontSize="12" FontWeight="Bold"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>
					</Button>
				</StackPanel>

			</Grid>
		</Grid>

		<!-- Botão de fechar -->
		<Button Width="40" Height="40"
				Margin="0,90,80,0" Padding="0"
				Background="Transparent"
				BorderBrush="Transparent"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Opacity="0.9"
				Click="CloseButton_Click">
			<Image Source="avares://Ultimate_Gshop/Resources/btn_close.png"/>
		</Button>

		<!-- Área transparente para arrastar a janela - Ultimate_Gshop -->
		<Border Background="Transparent"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Top"
				Width="250"
				Height="50"
				Margin="0,35,0,0"
				PointerPressed="TopDrag_PointerPressed">

			<TextBlock Text="Ultimate Gshop"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           FontSize="24"
		   FontWeight="Bold"
           Foreground="#ebb935"/>
		</Border>
	</Grid>

</Window>
