<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ultimate_Gshop.MenuWindow"
        Title="Menu"
        Width="375" Height="420"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
		CanResize="False"
		Icon="avares://Ultimate_Gshop/Resources/icon_gshop.ico">
	<Grid>
		<!-- imagem de fundo -->
		<Image Source="avares://Ultimate_Gshop/Resources/paper.png"
               Stretch="Fill"/>

		<StackPanel VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="3">

			<Button Background="Transparent"
					BorderThickness="0"
					Click="OnNewGshopClicked">
				<TextBlock Text="New Gshop"
						   FontFamily="Segoe Script"
						   FontSize="22"
						   FontWeight="Bold"
						   Opacity="0.85"
						   Foreground="White"/>
			</Button>

			<Button x:Name="btnContinue"
				Background="Transparent"
					BorderThickness="0"
					Click="OnContinueGshopClicked">
				<TextBlock Text="Continue Gshop"
						   FontFamily="Segoe Script"
						   FontSize="22"
						   FontWeight="Bold"
						   Opacity="0.85"
						   Foreground="White"/>
			</Button>


			<Button Background="Transparent"
					BorderThickness="0"
					Click="OnImportGshopClicked">
				<TextBlock Text="Import Gshop"
						   FontFamily="Segoe Script"
						   FontSize="22"
						   FontWeight="Bold"
						   Opacity="0.85"
						   Foreground="White"/>
			</Button>

			<Button x:Name="btnExportServer"
				Background="Transparent"
					BorderThickness="0"
					Click="OnExportServerClicked">
				<TextBlock Text="Export Gshop Server"
						   FontFamily="Segoe Script"
						   FontSize="22"
						   FontWeight="Bold"
						   Foreground="White"
						   Opacity="0.90" />
			</Button>

			<Button x:Name="btnExportClient"
				Background="Transparent"
					BorderThickness="0"
					Click="OnExportClientClicked">
				<TextBlock Text="Export Gshop Client"
						   FontFamily="Segoe Script"
						   FontSize="22"
						   FontWeight="Bold"
						   Foreground="White"
						   Opacity="0.90" />
			</Button>

			<Button Background="Transparent"
					BorderThickness="0"
					Click="OnOptionsClicked">
				<TextBlock Text="Options"
						   FontFamily="Segoe Script"
						   FontSize="22"
						   FontWeight="Bold"
						   Foreground="White"
						   Opacity="0.90" />
			</Button>

		</StackPanel>

		<!-- Botão de fechar -->
		<Button Width="55"
				Height="55"
				Margin="0,30,20,0"
				Background="Transparent"
				BorderBrush="Transparent"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Opacity="0.8"
				Click="CloseButton_Click">
			<Image Source="avares://Ultimate_Gshop/Resources/btn_close.png"/>
		</Button>
	</Grid>
</Window>
