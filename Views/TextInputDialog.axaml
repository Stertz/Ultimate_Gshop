<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="150"
		WindowStartupLocation="CenterOwner"
        CanResize="False"
        x:Class="Ultimate_Gshop.TextInputDialog"
        Title="TextInputDialog">
	<Grid>
		<Image Source="avares://Ultimate_Gshop/Resources/items_bg.png"
	   Stretch="Fill" />
		<StackPanel Margin="10" Spacing="10">
			<TextBlock Text="{Binding Prompt}" />
			<TextBox Text="{Binding InputText, Mode=TwoWay}" />

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
				<Button Content="OK" Width="70" IsDefault="True" Click="Ok_Click"/>
				<Button Content="Cancel" Width="70" IsCancel="True" Click="Cancel_Click"/>
			</StackPanel>
		</StackPanel>
	</Grid>

</Window>
